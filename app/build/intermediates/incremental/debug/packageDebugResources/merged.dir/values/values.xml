<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#6750A4</color>
    <string name="app_name">InnerLog</string>
    <style name="Theme.InnerLog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.InnerLog.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.InnerLog</item>
    </style>
</resources>